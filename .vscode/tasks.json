{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "label": "npm: dev",
      "detail": "Starts Vite local development server on port 3000",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*ready in.*",
          "endsPattern": ".*Local:.*http://.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "build",
      "label": "npm: build",
      "detail": "Builds production assets with Vite",
      "group": "build"
    },
    {
      "type": "npm",
      "script": "preview",
      "label": "npm: preview",
      "detail": "Previews the built production site locally on port 3000"
    },
    {
      "type": "npm",
      "script": "lint",
      "label": "npm: typecheck",
      "detail": "Runs TypeScript type checker (tsc --noEmit)",
      "group": "test"
    }
  ]
}
